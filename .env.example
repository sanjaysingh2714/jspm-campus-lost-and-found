# JSPM Campus Lost & Found - Environment Variables
# Copy this file to .env.local or .env for local development

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (From Supabase Dashboard -> Project Settings -> API -> anon public key)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Set to true if you want to bypass cloud network requirements in offline demo mode
# VITE_DEMO_MODE=false
